{
  "name": "wdk-protocol-swap-jupiter-solana",
  "version": "0.1.0",
  "description": "Lets @tetherto/wdk-wallet-solana wallet accounts swap SPL tokens through the Jupiter aggregator (Swap API v2 /build, with v1 as a documented fallback). The Solana peer of @tetherto/wdk-protocol-swap-velora-evm.",
  "keywords": [
    "wdk",
    "protocol",
    "swap",
    "solana",
    "jupiter",
    "spl"
  ],
  "author": "cryptoyasenka",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptoyasenka/wdk-jupiter-solana-spikes.git"
  },
  "bugs": {
    "url": "https://github.com/cryptoyasenka/wdk-jupiter-solana-spikes/issues"
  },
  "homepage": "https://github.com/cryptoyasenka/wdk-jupiter-solana-spikes#readme",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "bare.js",
    "src",
    "types"
  ],
  "scripts": {
    "build:types": "tsc",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "spike:a": "bare spikes/phase-0/spike-a-bare-fetch-tls.cjs",
    "spike:b:sim": "node spikes/phase-0/spike-b-sim-mainnet.mjs",
    "spike:b:surfpool": "node spikes/phase-0/spike-b-alt-route-surfpool.mjs"
  },
  "dependencies": {
    "@tetherto/wdk-wallet": "1.0.0-beta.7",
    "@tetherto/wdk-wallet-solana": "1.0.0-beta.9",
    "@solana/addresses": "3.0.3",
    "@solana/instructions": "3.0.3",
    "@solana/transaction-messages": "3.0.3",
    "@solana-program/address-lookup-table": "0.9.0"
  },
  "devDependencies": {
    "@solana/kit": "4.0.0",
    "bare": "1.28.5",
    "bare-fetch": "3.0.1",
    "cross-env": "10.0.0",
    "jest": "30.0.5",
    "standard": "17.1.2",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "standard": {
    "ignore": [
      "bare.js",
      "tests/**/*.js",
      "spikes/**/*",
      "types/**/*"
    ]
  }
}
